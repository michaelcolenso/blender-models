{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildingseattle.com/schemas/construction-intelligence/project-state.schema.json",
  "title": "Construction Intelligence Project State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "evidence", "claims", "elements", "relationships", "quantities", "activities", "issues", "scenarios"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "quantities": {"type": "array", "items": {"$ref": "#/$defs/quantity"}},
    "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "status": {"enum": ["confirmed", "provisional", "assumed", "unknown"]},
    "confidence": {"enum": ["high", "medium", "low", "none"]},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "source"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "source": {"type": "string"}, "locator": {"type": ["string", "null"]}, "description": {"type": ["string", "null"]}, "checksum": {"type": ["string", "null"]}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["id", "subject_id", "predicate", "value", "evidence_ids", "status", "confidence"], "properties": {"id": {"type": "string"}, "subject_id": {"type": "string"}, "predicate": {"type": "string"}, "value": {}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "status": {"$ref": "#/$defs/status"}, "confidence": {"$ref": "#/$defs/confidence"}, "rationale": {"type": ["string", "null"]}}},
    "element": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "name", "project_id", "source_ids", "status", "properties"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "name": {"type": "string"}, "project_id": {"type": "string"}, "parent_id": {"type": ["string", "null"]}, "source_ids": {"type": "array", "items": {"type": "string"}}, "status": {"$ref": "#/$defs/status"}, "properties": {"type": "object"}, "geometry_ref": {"type": ["string", "null"]}}},
    "relationship": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "from_id", "to_id", "properties"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "from_id": {"type": "string"}, "to_id": {"type": "string"}, "properties": {"type": "object"}}},
    "quantity": {"type": "object", "additionalProperties": false, "required": ["id", "element_id", "measure", "value", "unit", "source_claim_ids"], "properties": {"id": {"type": "string"}, "element_id": {"type": "string"}, "measure": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}, "scenario_id": {"type": ["string", "null"]}, "source_claim_ids": {"type": "array", "items": {"type": "string"}}}},
    "activity": {"type": "object", "additionalProperties": false, "required": ["id", "name", "phase", "element_ids", "predecessor_ids", "assumptions"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "phase": {"type": "string"}, "element_ids": {"type": "array", "items": {"type": "string"}}, "duration_working_days": {"type": ["number", "null"], "minimum": 0}, "predecessor_ids": {"type": "array", "items": {"type": "string"}}, "assumptions": {"type": "array", "items": {"type": "string"}}}},
    "issue": {"type": "object", "additionalProperties": false, "required": ["id", "title", "description", "severity", "element_ids", "claim_ids", "resolution_status"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "severity": {"type": "string"}, "element_ids": {"type": "array", "items": {"type": "string"}}, "claim_ids": {"type": "array", "items": {"type": "string"}}, "resolution_status": {"type": "string"}}},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["id", "name", "description", "inputs"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "inputs": {"type": "object"}, "derived_from": {"type": ["string", "null"]}}}
  }
}
