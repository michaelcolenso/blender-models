      "gate": "Confirm route, access and isolation boundaries before work.",
      "view": "bath"
    },
    {
      "id": "mains",
      "seconds": 5,
      "title": "02 / Install parallel distribution",
      "action": "New supply and circulation paths appear alongside the reference network.",
      "service": "Existing supply retained \u2022 new piping not in service",
      "gate": "Spacing is graphic only; final routing and materials remain open.",
      "view": "unit"
    },
    {
      "id": "branches",
      "seconds": 5,
      "title": "03 / Run branches to the fixtures",
