+    bpy.context.scene.camera=rcam
 
     bpy.ops.object.light_add(type='SUN',location=(BUILDING_LENGTH/2,-ft(20),ft(70)))
     sun=bpy.context.object; sun.name="MEYD_SUN"; relink_object(sun,coll); tag(sun,3,"Visualization light")
