+    rcam=bpy.context.object; rcam.name="MEYD_B101_REVIEW_CAMERA"; relink_object(rcam,coll)
+    tag(rcam,3,"v4.1 B-101 demolition review camera (orthographic cutaway)")
+    rcam.rotation_euler=(Vector((ft(22),ft(20),0))-rcam.location).to_track_quat('-Z','Y').to_euler()
+    rcam.data.type='ORTHO'; rcam.data.ortho_scale=ft(62)
+    for o in bpy.data.objects:
+        if o.name.startswith(('BldgB_UpperFloor_','East_Garage_Block_','CTX_')) or o.name in ('East_Exterior_Wall','North_Exterior_Wall','Subgrade_Soil_Mass'):
