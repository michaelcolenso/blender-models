             obj["NOMINAL_DIAMETER_IN"] = dia
 
 
+# v4.1: plan extent of B101_DEMO_PriorRepair_NoDemo_Envelope (same centre/size as its create_box in pass 3).
+NO_DEMO_ENVELOPE_XY = ((ft(32.0) - ft(12.5), ft(32.0) + ft(12.5)), (ft(35.5) - ft(8.0), ft(35.5) + ft(8.0)))
+
+
+def clip_cutter_to_no_demo_envelope(obj):
+    """v4.1: trim a trench cutter so it never opens slab inside the prior-repair no-demo envelope.
+
+    v4 cutter end extensions (0.55 x width) pushed TrenchCutter_B101_001/008 about 0.9 ft past the
+    prior-ABS tie (23.25, 27.4) into the envelope. The envelope stays FIELD_VERIFY; this only stops the
+    model from cutting slab the contract says not to demolish. Clips along the envelope's south edge,
+    which is the only edge the B101 route approaches."""
+    import bmesh
+    (x0, x1), (y0, y1) = NO_DEMO_ENVELOPE_XY
+    bpy.context.view_layer.update()
+    corners = [obj.matrix_world @ Vector(c) for c in obj.bound_box]
+    if max(c.x for c in corners) <= x0 or min(c.x for c in corners) >= x1:
+        return False
+    if max(c.y for c in corners) <= y0 or min(c.y for c in corners) >= y1:
+        return False
+    inv = obj.matrix_world.inverted()
+    co = inv @ Vector((0.0, y0, 0.0))
+    no = (obj.matrix_world.to_3x3().transposed() @ Vector((0.0, 1.0, 0.0))).normalized()  # world->local normal
+    bm = bmesh.new(); bm.from_mesh(obj.data)
+    geom = bm.verts[:] + bm.edges[:] + bm.faces[:]
+    bmesh.ops.bisect_plane(bm, geom=geom, plane_co=co, plane_no=no, clear_outer=True)
+    bmesh.ops.holes_fill(bm, edges=bm.edges[:], sides=0)
+    bm.to_mesh(obj.data); bm.free(); obj.data.update()
+    obj["V41_CLIPPED_AT_NO_DEMO_ENVELOPE"] = True
+    return True
+
+
 def build_trench_cutters(mats):
